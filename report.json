  "email_html_body": "\n    <div style=\"font-family: -apple-system, 'PingFang TC', 'Microsoft JhengHei', sans-serif; max-width: 680px; margin: 0 auto; color: #1f2937;\">\n      <h1 style=\"color: #007bff; text-align:center; font-size: 24px;\">GitHub 開源科技報告</h1>\n      <p style=\"text-align:center; color:#666; margin-bottom: 30px;\">日期: 2026-09-19</p>\n    \n      <h2 style=\"border-bottom: 2px solid #e5e7eb; padding-bottom: 8px; margin-top: 32px;\">辦公室應用</h2>\n        \n      <div style=\"background:#f9fafb; border-radius:8px; padding:16px; margin-bottom:14px; border:1px solid #e5e7eb;\">\n        <p style=\"margin:0 0 6px 0;\">\n          <strong style=\"color:#007bff; font-size:1.1em;\">Compositor</strong>\n          <span style=\"background:#3b82f6; color:#fff; font-size:0.75em; padding:2px 8px; border-radius:10px; margin-left:8px;\">Fast-Rising</span>\n          \n        </p>\n        <p style=\"margin:0 0 8px 0; color:#666; font-size:0.9em;\">語言: Swift | Star: 2,387</p>\n        <p style=\"margin:0 0 10px 0; font-size:0.95em; line-height:1.6;\">一款專為Mac平台設計的Photoshop替代品，提供影像編輯與合成功能，為設計師和內容創作者提供專業的視覺處理工具。</p>\n        <p style=\"margin:0; font-size:0.9em;\">\n          <a href=\"https://github.com/robbietilton/Compositor\" style=\"color:#007bff; text-decoration:none;\">原始連結</a>\n          &nbsp;|&nbsp;\n          <a href=\"https://github.com/Kevinte67228/AI-Skill/tree/main/辦公室應用/Compositor\" style=\"color:#007bff; text-decoration:none;\">本地倉庫路徑</a>\n        </p>\n      </div>\n            \n      <h2 style=\"border-bottom: 2px solid #e5e7eb; padding-bottom: 8px; margin-top: 32px;\">寫程式</h2>\n        \n      <div style=\"background:#f9fafb; border-radius:8px; padding:16px; margin-bottom:14px; border:1px solid #e5e7eb;\">\n        <p style=\"margin:0 0 6px 0;\">\n          <strong style=\"color:#007bff; font-size:1.1em;\">public-apis</strong>\n          <span style=\"background:#22c55e; color:#fff; font-size:0.75em; padding:2px 8px; border-radius:10px; margin-lef